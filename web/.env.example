# Build-time version injected into the MF remote (TOTP_GATE_VERSION).
# serf writes the real TAG_VERSION here on deploy (slave repo .env).
# Empty/absent -> webpack falls back to '0.0.0.0.0.0'.
TAG_VERSION=

# Backend base for the standalone admin page (WEB_BACK_URL).
# LOCAL DEV: leave empty -> API base '/totp' on the same origin
# (ng serve proxies /totp -> http://localhost:3278 per proxy.conf.json).
# PRODUCTION: set an absolute URL (e.g. https://other-host/totp) when web is
# deployed on a different host than the back service.
# Empty -> derive from <base href>, fallback '/totp' (same host as back).
BACK_URL=

# Deployment base path baked into <base href> of the built index.html,
# so assets/favicon resolve under the deploy path (default '/totp-web/').
# Set to '/' when the app is served at the domain root.
WEB_BASE_HREF=