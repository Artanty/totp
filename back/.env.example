# MySQL connection params
DB_HOST="YOUR_HOST"
DB_DATABASE="YOUR_DB"
DB_USERNAME="YOUR_USER"
DB_PASSWORD="YOUR_PASSWORD"
# optional override
# DB_PORT=3306
# 32-byte key in hex (64 hex chars) used to encrypt TOTP secrets at rest
# generate with: openssl rand -hex 32
TOTP_MASTER_KEY=""
# Secret for signing JWTs
JWT_SECRET=""
# HTTP listen port
PORT=3000
# URL prefix for API routes (reverse proxy path)
API_PREFIX=/totp
# Public base URL of this service INCLUDING the API_PREFIX, shown to new apps
# as TOTP_BACK_URL (e.g. https://pomi-doro.ru/totp). Optional; empty if unset.
# TOTP_BACK_URL=https://example.com/totp
# Authenticated TOTP gate (requires a JWT from {API_PREFIX}/auth/login).
#   POST {API_PREFIX}/auth/totp/init   body {tokenId?} -> resolves App by
#       gateUserId (or the authenticated user's own token when tokenId is sent;
#       falls back to TOTP_TOKEN_ID below when tokenId is omitted)
#       and creates a GateSession -> {gateSessionId, nonce, expiresAt}
#   POST {API_PREFIX}/auth/totp/verify body {code, nonce} -> verifies the code
#       against the GateSession's token -> {valid, expiresAt, nonce} or 401
# Default token id used by the admin gate when the client sends no tokenId.
# Single source of truth (totp/web carries no token ids).
# TOTP_TOKEN_ID=5
# Optional: max verify attempts per IP per minute (default 10).
# TOTP_GUARD_RATE_LIMIT=10
# Skip the TOTP 2FA gate in the admin web. The web reads it at runtime from
# {API_PREFIX}/auth/totp/status, so this is the single source of truth.
# Dev only!
# BYPASS_TOTP=false