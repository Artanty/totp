# MySQL connection params
DB_HOST="YOUR_HOST"
DB_DATABASE="YOUR_DB"
DB_USERNAME="YOUR_USER"
DB_PASSWORD="YOUR_PASSWORD"
# optional override
# DB_PORT=3306
# 32-byte key in hex (64 hex chars) used to encrypt TOTP secrets at rest
# generate with: openssl rand -hex 32
TOTP_MASTER_KEY=""
# Secret for signing JWTs
JWT_SECRET=""
# HTTP listen port
PORT=3000
# URL prefix for API routes (reverse proxy path)
API_PREFIX=/totp